#!/usr/bin/env python3
# emulator-lease: share headless Android emulators machine-wide, one owner per emulator.
#   emulator-lease acquire <owner> [--avd NAME] [--pid PID]   print the serial; boot the emulator if needed
#   emulator-lease release <owner>                           drop the lease and stop the emulator
#   emulator-lease status                                    per slot: free, or owner, serial, age
# Two modes:
#   Script holding the lease for its whole run (a justfile recipe): pass --pid $$. The lease is
#     reclaimed as soon as that pid is dead.
#   Agent, one short-lived shell per Bash call: no --pid. Start every Bash call with
#     serial="$(emulator-lease acquire me)" || exit $?
#     (the holder's acquire is a heartbeat: same serial, lease age reset), and run
#     emulator-lease release me at the end. A busy exit 75 must be checked, never ignored.
# Slots: at most MAX emulators at once (2 when RAM >= 32 GB, else 1; probe in claude/tools/resources.py).
# One lease file per slot (lease-0.json, lease-1.json) in the state dir; an owner holds at most one slot.
# Slot 0 boots as a single emulator always did (first free console port, normally 5554). Slot N>0 boots
# the same AVD as an extra -read-only instance on console port 5554+2N, so its serial is emulator-(5554+2N).
# A legacy lease.json from an older run is renamed to lease-0.json.
# Lease: JSON file (owner, owner pid or null, emulator pid, serial, time of last touch) per slot.
# The owner pid is tracked only with --pid. A lease is stale when its pid is dead or it was last
# touched more than EMULATOR_LEASE_MAX_AGE ago; a stale lease is reclaimed and its emulator reused if booted.
# Queue: FIFO tickets as in heavy-slot; tickets of dead pids are dropped. The head takes the first free slot.
# Env: EMULATOR_LEASE_MAX (from machine RAM), EMULATOR_AVD (AVD when --avd is absent), EMULATOR_LEASE_DIR (~/.cache/emulator-lease),
# EMULATOR_LEASE_WAIT seconds (540, under the 10 min Bash cap), EMULATOR_LEASE_POLL seconds (2),
# EMULATOR_LEASE_MAX_AGE seconds (3600), EMULATOR_BOOT_TIMEOUT seconds (300).
# Exit codes: 0 ok, 2 usage or no AVD, 75 emulator busy within the wait limit ("emulator busy, run again"),
# 1 boot failed. Stdout carries only the serial; diagnostics go to stderr.
import fcntl
import json
import os
import signal
import subprocess
import sys
import time

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import resources  # noqa: E402

DIR = os.environ.get("EMULATOR_LEASE_DIR") or os.path.expanduser("~/.cache/emulator-lease")
WAIT = float(os.environ.get("EMULATOR_LEASE_WAIT", "540"))
POLL = float(os.environ.get("EMULATOR_LEASE_POLL", "2"))
MAX_AGE = float(os.environ.get("EMULATOR_LEASE_MAX_AGE", "3600"))
BOOT_TIMEOUT = float(os.environ.get("EMULATOR_BOOT_TIMEOUT", "300"))
MAX = max(1, int(os.environ.get("EMULATOR_LEASE_MAX") or resources.default_emulator_max()))
BASE_PORT = 5554


def log(msg):
    print(f"emulator-lease: {msg}", file=sys.stderr, flush=True)


def lease_path(slot):
    return os.path.join(DIR, f"lease-{slot}.json")


def slot_port(slot):
    """Console port for slot N>0; slot 0 takes the emulator's default."""
    return None if slot == 0 else BASE_PORT + 2 * slot


def migrate_legacy():
    """A lease.json from before slots becomes slot 0 (call under the state lock)."""
    old = os.path.join(DIR, "lease.json")
    if os.path.exists(old) and not os.path.exists(lease_path(0)):
        os.replace(old, lease_path(0))
    elif os.path.exists(old):
        os.unlink(old)


def read_lease(slot):
    try:
        with open(lease_path(slot)) as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def write_lease(slot, lease):
    tmp = lease_path(slot) + ".tmp"
    with open(tmp, "w") as f:
        json.dump(lease, f)
    os.replace(tmp, lease_path(slot))


def drop_lease(slot):
    try:
        os.unlink(lease_path(slot))
    except OSError:
        pass


def alive(pid):
    try:
        os.kill(int(pid), 0)
    except ProcessLookupError:
        return False
    except (OSError, TypeError, ValueError):
        pass
    return True


def stale(lease):
    return (lease.get("pid") is not None and not alive(lease["pid"])) or time.time() - lease.get("time", 0) > MAX_AGE


def adb(*args, timeout=30):
    """Stdout of adb, or "" when it fails."""
    try:
        return subprocess.run(["adb", *args], capture_output=True, text=True, timeout=timeout).stdout
    except (OSError, subprocess.SubprocessError):
        return ""


def running_serial(slot=0):
    """Serial of the emulator of this slot: slot N>0 is fixed to its port; slot 0 is the first
    emulator that is not on another slot's port."""
    others = {f"emulator-{slot_port(i)}" for i in range(1, MAX)}
    for line in adb("devices").splitlines()[1:]:
        parts = line.split()
        if len(parts) >= 2 and parts[0].startswith("emulator-"):
            if slot == 0 and parts[0] not in others:
                return parts[0]
            if slot != 0 and parts[0] == f"emulator-{slot_port(slot)}":
                return parts[0]
    return None


def start_emulator(avd, port=None):
    """Boot detached and headless; return the emulator pid."""
    logf = open(os.path.join(DIR, "emulator.log"), "ab")
    extra = ["-port", str(port)] if port else []
    p = subprocess.Popen(
        ["emulator", "-avd", avd, "-no-window", "-no-audio", "-no-boot-anim", "-read-only", *extra],
        stdout=logf, stderr=logf, stdin=subprocess.DEVNULL, start_new_session=True)
    return p.pid


def booted(serial):
    return adb("-s", serial, "shell", "getprop", "sys.boot_completed").strip() == "1"


def proc_exited(pid):
    """True when the emulator process we spawned has exited."""
    try:
        done, _ = os.waitpid(pid, os.WNOHANG)
        return done == pid
    except ChildProcessError:
        return not alive(pid)
    except OSError:
        return False


def stop_emulator(pid, serial=None):
    """Ask adb to kill the emulator, then SIGTERM its whole process group (started with
    start_new_session, so the pid is the pgid and the qemu child is in it)."""
    if serial:
        adb("-s", serial, "emu", "kill", timeout=10)
    try:
        os.killpg(pid, signal.SIGTERM)
    except (OSError, TypeError):
        try:
            os.kill(pid, signal.SIGTERM)
        except (OSError, TypeError):
            pass


def wait_booted(budget, epid=None, slot=0):
    """(serial, exited): serial of the booted emulator or None; exited is True when the spawned process died."""
    deadline = time.monotonic() + budget
    while time.monotonic() < deadline:
        if epid is not None and proc_exited(epid):
            return None, True
        serial = running_serial(slot)
        if serial:
            adb("-s", serial, "wait-for-device", timeout=max(1, deadline - time.monotonic()))
            if booted(serial):
                return serial, False
        time.sleep(min(POLL, 1))
    return None, False


def take_ticket():
    qdir = os.path.join(DIR, "queue")
    os.makedirs(qdir, exist_ok=True)
    with open(os.path.join(DIR, "counter"), "a+") as f:
        fcntl.flock(f, fcntl.LOCK_EX)
        f.seek(0)
        n = int(f.read().strip() or "0")
        f.seek(0)
        f.truncate()
        f.write(str(n + 1))
        path = os.path.join(qdir, f"{n:010d}.{os.getpid()}")
        open(path, "w").close()
    return path


def is_head(ticket):
    qdir = os.path.dirname(ticket)
    for name in sorted(os.listdir(qdir)):
        path = os.path.join(qdir, name)
        if path == ticket:
            return True
        try:
            pid = int(name.split(".")[1])
        except (IndexError, ValueError):
            pid = 0
        if pid and alive(pid):
            return False
        try:
            os.unlink(path)
        except OSError:
            pass
    return False


class State:
    """Exclusive lock around lease changes."""

    def __enter__(self):
        os.makedirs(DIR, exist_ok=True)
        self.f = open(os.path.join(DIR, "state.lock"), "a+")
        fcntl.flock(self.f, fcntl.LOCK_EX)
        migrate_legacy()

    def __exit__(self, *_):
        self.f.close()


def pick_slot(owner):
    """(slot, lease) to use: the owner's live slot, else the first free or stale slot, else (None, None)."""
    free = None
    for slot in range(MAX):
        lease = read_lease(slot)
        if lease and lease.get("owner") == owner and not stale(lease):
            return slot, lease
        if free is None and (not lease or stale(lease)):
            free = (slot, lease)
    return free or (None, None)


def try_take(owner, avd, pid, deadline):
    """Return (status, serial): status is 'ok', 'busy' or 'fail'.
    The state lock is held while booting (bounded by BOOT_TIMEOUT and the acquire deadline),
    so other acquirers and release wait for the boot."""
    with State():
        slot, lease = pick_slot(owner)
        if slot is None:
            return "busy", None
        epid = lease.get("emulator_pid") if lease else None
        if lease and lease.get("owner") == owner and not stale(lease):
            serial = lease.get("serial")
            if serial and adb("-s", serial, "get-state").strip() == "device":
                lease["pid"] = pid
                lease["time"] = time.time()
                write_lease(slot, lease)
                return "ok", serial
            log("holder's emulator is gone, booting again")
        elif lease:
            log(f"reclaiming stale lease of {lease.get('owner')}")
        serial = running_serial(slot)
        if serial and not booted(serial):
            serial = None
        if not serial:
            if not avd:
                return "fail", None
            started = False
            if running_serial(slot) is None:
                log(f"booting {avd}")
                epid = start_emulator(avd, slot_port(slot)) if slot else start_emulator(avd)
                started = True
            remaining = deadline - time.monotonic()
            budget = max(0.0, min(BOOT_TIMEOUT, remaining))
            serial, exited = wait_booted(budget, epid if started else None, slot)
            if not serial:
                if not exited and remaining < BOOT_TIMEOUT:
                    # Out of acquire time, not a boot failure: leave the emulator for the next acquire.
                    log("acquire time ran out while booting, emulator left running")
                    return "busy", None
                if started:
                    stop_emulator(epid, running_serial(slot))
                drop_lease(slot)
                return "fail", None
        write_lease(slot, {"owner": owner, "pid": pid, "emulator_pid": epid, "serial": serial,
                           "time": time.time()})
        return "ok", serial


def cmd_acquire(owner, avd, pid):
    os.makedirs(DIR, exist_ok=True)
    ticket = take_ticket()
    deadline = time.monotonic() + WAIT
    announced = False
    try:
        while True:
            if is_head(ticket):
                status, serial = try_take(owner, avd, pid, deadline)
                if status == "ok":
                    print(serial)
                    return 0
                if status == "fail":
                    log("emulator failed to boot")
                    return 1
            if time.monotonic() >= deadline:
                log("emulator busy, run again")
                return 75
            if not announced:
                log("waiting for the emulator")
                announced = True
            time.sleep(min(POLL, max(0.0, deadline - time.monotonic())))
    finally:
        try:
            os.unlink(ticket)
        except OSError:
            pass


def cmd_release(owner):
    with State():
        for slot in range(MAX):
            lease = read_lease(slot)
            if lease and lease.get("owner") == owner:
                if lease.get("serial"):
                    adb("-s", lease["serial"], "emu", "kill")
                drop_lease(slot)
                return 0
    log(f"{owner} holds no lease, nothing stopped")
    return 0


def cmd_status():
    with State():
        for slot in range(MAX):
            lease = read_lease(slot)
            prefix = f"slot {slot}: " if MAX > 1 else ""
            if not lease or stale(lease):
                print(f"{prefix}free")
            else:
                print(f"{prefix}{lease.get('owner')}, {lease.get('serial')}, "
                      f"{int(time.time() - lease.get('time', 0))}s")
    return 0


def main(argv):
    usage = "usage: emulator-lease acquire <owner> [--avd NAME] [--pid PID] | release <owner> | status"
    args = list(argv)
    avd, pid = os.environ.get("EMULATOR_AVD"), None
    for flag in ("--avd", "--pid"):
        if flag in args:
            i = args.index(flag)
            if i + 1 >= len(args):
                print(usage, file=sys.stderr)
                return 2
            val = args[i + 1]
            del args[i:i + 2]
            if flag == "--avd":
                avd = val
            else:
                pid = int(val)
    if args == ["status"]:
        return cmd_status()
    if len(args) == 2 and args[0] == "release":
        return cmd_release(args[1])
    if len(args) == 2 and args[0] == "acquire":
        if not avd:
            log("no AVD: pass --avd NAME or set EMULATOR_AVD")
            return 2
        return cmd_acquire(args[1], avd, pid)
    print(usage, file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
