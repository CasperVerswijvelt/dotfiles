#!/usr/bin/env python3
# heavy-slot <command> [args...]: run a command under one of SLOTS machine-wide slots.
# Scope: heavy = app test suites and full builds. Hooks run format and analyze outside the slot
# (they must stay seconds-fast); gate runs put analyze and tests inside it. The emulator is outside the cap.
# Queue: FIFO. Each waiter takes a ticket (counter file plus a queue/ dir under the lock dir)
# and may take a slot only when it holds the lowest live ticket. Tickets of dead pids are dropped.
# Memory: at the head of the queue, a slot is taken only when free memory (macOS
# `memory_pressure -Q`, "ok" if the probe fails) is at least HEAVY_SLOT_MIN_FREE_PCT; else keep waiting.
# Slots: default max(1, min((ram_gb - 8) // 8, ceil(perf_cores / 3))) from sysctl (claude/tools/resources.py);
# 2 when sysctl fails. HEAVY_SLOTS overrides.
# Env: HEAVY_SLOTS (from machine resources), HEAVY_SLOT_WAIT seconds (540, under the 10 min Bash cap),
# HEAVY_SLOT_POLL seconds (2), HEAVY_SLOT_MIN_FREE_PCT (10), HEAVY_SLOT_DIR (~/.cache/heavy-slot).
# Concurrency: flutter test has no env var for it; callers pass --concurrency themselves.
# Exit codes: the child's (128+N when killed by signal N), or 75 when no slot freed within the wait limit
# ("machine busy, run again").
import fcntl
import os
import re
import signal
import subprocess
import sys
import time

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import resources  # noqa: E402

SLOTS = int(os.environ.get("HEAVY_SLOTS") or resources.default_heavy_slots())
WAIT = float(os.environ.get("HEAVY_SLOT_WAIT", "540"))
POLL = float(os.environ.get("HEAVY_SLOT_POLL", "2"))
MIN_FREE_PCT = float(os.environ.get("HEAVY_SLOT_MIN_FREE_PCT", "10"))
LOCK_DIR = os.environ.get("HEAVY_SLOT_DIR") or os.path.expanduser("~/.cache/heavy-slot")


def try_acquire():
    os.makedirs(LOCK_DIR, exist_ok=True)
    for i in range(SLOTS):
        fd = os.open(os.path.join(LOCK_DIR, f"slot-{i}.lock"), os.O_RDWR | os.O_CREAT, 0o644)
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            os.set_inheritable(fd, False)
            return fd
        except OSError:
            os.close(fd)
    return None


def free_pct():
    """Free memory percent, or None when the probe fails."""
    try:
        out = subprocess.run(["memory_pressure", "-Q"], capture_output=True, text=True, timeout=5).stdout
        m = re.search(r"free percentage:\s*(\d+)", out)
        return int(m.group(1)) if m else None
    except (OSError, subprocess.SubprocessError):
        return None


def memory_ok():
    pct = free_pct()
    return pct is None or pct >= MIN_FREE_PCT


def take_ticket():
    qdir = os.path.join(LOCK_DIR, "queue")
    os.makedirs(qdir, exist_ok=True)
    with open(os.path.join(LOCK_DIR, "counter"), "a+") as f:
        fcntl.flock(f, fcntl.LOCK_EX)
        f.seek(0)
        n = int(f.read().strip() or "0")
        f.seek(0)
        f.truncate()
        f.write(str(n + 1))
        path = os.path.join(qdir, f"{n:010d}.{os.getpid()}")
        with open(path, "w"):
            pass
    return path


def alive(pid):
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except OSError:
        pass
    return True


def is_head(ticket):
    qdir = os.path.dirname(ticket)
    for name in sorted(os.listdir(qdir)):
        path = os.path.join(qdir, name)
        if path == ticket:
            return True
        try:
            pid = int(name.split(".")[1])
        except (IndexError, ValueError):
            pid = 0
        if pid and alive(pid):
            return False
        try:
            os.unlink(path)
        except OSError:
            pass
    return False


def acquire(wait, poll):
    """Wait in the FIFO queue for a slot; return the lock fd, or None on timeout."""
    ticket = take_ticket()
    deadline = time.monotonic() + wait
    announced = False
    try:
        while True:
            if is_head(ticket) and memory_ok():
                fd = try_acquire()
                if fd is not None:
                    return fd
            if time.monotonic() >= deadline:
                return None
            if not announced:
                print("waiting for a test slot", file=sys.stderr, flush=True)
                announced = True
            time.sleep(min(poll, max(0.0, deadline - time.monotonic())))
    finally:
        try:
            os.unlink(ticket)
        except OSError:
            pass


child = None


def on_signal(signum, _frame):
    if child is None:
        sys.exit(128 + signum)
    child.send_signal(signum)


def main():
    global child
    cmd = sys.argv[1:]
    if not cmd:
        print("usage: heavy-slot <command> [args...]", file=sys.stderr)
        return 2
    if os.environ.get("HEAVY_SLOT_HELD") == "1":
        os.execvp(cmd[0], cmd)
    for sig in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
        signal.signal(sig, on_signal)
    fd = acquire(WAIT, POLL)
    if fd is None:
        print("machine busy, run again", file=sys.stderr)
        return 75
    env = dict(os.environ, HEAVY_SLOT_HELD="1")
    try:
        child = subprocess.Popen(cmd, env=env, close_fds=True)
    except OSError as e:
        print(f"heavy-slot: {e}", file=sys.stderr)
        return 127
    rc = child.wait()
    return 128 - rc if rc < 0 else rc


if __name__ == "__main__":
    sys.exit(main())
