{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "git -C ~/dotfiles pull --ff-only -q >/dev/null 2>&1 || true",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
